# Zelmoriq root rules (Apache). Safe to delete if you do not need them.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$   robots.php  [L]
  RewriteRule ^sitemap\.xml$  sitemap.php [L]
</IfModule>

# Never expose Git or editor files
<FilesMatch "^\.(git|gitignore|gitattributes|env|vscode)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|sql|log|lock|json|example\.php)$">
  Require all denied
</FilesMatch>
